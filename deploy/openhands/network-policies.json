        "namespace": "claimsieve-openhands"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "claimsieve-openhands-adversary"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [],
        "egress": []
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "openhands-to-claimsieve-intake-only",
        "namespace": "claimsieve-openhands"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "claimsieve-openhands-adversary"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "claimsieve-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "claimsieve-intake"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8443
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
