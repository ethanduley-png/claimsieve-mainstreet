{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimsieve.example/schemas/proposal.schema.json",
  "title": "ClaimSieve Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "trace_id",
    "tenant_id",
    "campaign_id",
    "session_id",
    "principal",
    "objective",
    "action",
    "evidence_refs",
    "requested_at_seq",
    "risk_tags"
  ],
  "properties": {
    "schema_version": {
      "const": "claimsieve.proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_action_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "principal": {
      "type": "string",
      "pattern": "^spiffe://"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "subgoal",
        "expected_effect",
        "constraints"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subgoal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "constraints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "effect_class",
        "destination",
        "method",
        "parameters",
        "reversibility"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "send_message",
            "create_calendar_event",
            "update_record",
            "fetch_artifact",
            "upload_data",
            "run_connector",
            "compensate"
          ]
        },
        "effect_class": {
          "type": "string",
          "enum": [
            "read",
            "external_write",
            "code_execution",
            "credential_use",
            "privilege_change",
            "network_boundary",
            "compensation"
          ]
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "authority",
            "resource",
            "trust_domain"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "trust_domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "parameters": {
          "type": "object"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "reversible",
            "compensable",
            "irreversible",
            "unknown"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "approval_id",
        "approver",
        "proposal_digest",
        "display_digest",
        "approved_at_seq",
        "expires_at_seq",
        "approver_key_id",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "claimsieve.approval.v1"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approver": {
          "type": "string",
          "pattern": "^spiffe://"
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "display_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "approved_at_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approver_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]+$"
        }
      }
    },
    "requested_at_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "risk_tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]{1,64}$"
      }
    }
  }
}
