{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimsieve.local/schemas/executor-command.schema.json",
  "title": "ClaimSieve Executor Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "reservation_id",
    "executor_id",
    "sequence",
    "executor_key_id",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "claimsieve.executor_command.v1"},
    "command": {"enum": ["BEGIN_EXECUTION", "CLAIM_DISPATCH"]},
    "reservation_id": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "executor_key_id": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1}
  }
}
