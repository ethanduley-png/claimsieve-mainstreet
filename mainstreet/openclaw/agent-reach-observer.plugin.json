{
  "id": "mainstreet-agent-reach-observer",
  "name": "MainStreet Agent Reach Untrusted Observer",
  "version": "0.34.0",
  "description": "Prepares read-only capability requests and validates tainted observations. It has no execution authority.",
  "entry": "../src/agent-reach-untrusted.js",
  "trust": "explicitly-untrusted",
  "capabilities": [
    "observation.request.prepare",
    "observation.envelope.validate"
  ],
  "requiredEnvironment": [
    "AGENT_REACH_OBSERVER_SPIFFE_ID"
  ],
  "forbiddenEnvironmentPrefixes": [
    "CLAIMSIEVE_SIGNING_",
    "CLAIMSIEVE_PERMIT_",
    "TWILIO_",
    "STRIPE_",
    "AWS_SECRET_",
    "OPENAI_API_KEY",
    "GITHUB_WRITER_"
  ],
  "forbiddenCapabilities": [
    "provider.write",
    "provider.execute",
    "permit.sign",
    "permit.reserve",
    "approval.create",
    "shell.generic"
  ]
}
