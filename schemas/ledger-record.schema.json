{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimsieve.example/schemas/ledger-record.schema.json",
  "title": "ClaimSieve Ledger Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "sequence",
    "trace_id",
    "record_type",
    "previous_hash",
    "payload",
    "payload_hash",
    "writer_key_id",
    "signature",
    "record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "claimsieve.ledger_record.v1"
    },
    "ledger_id": {
      "type": "string",
      "enum": [
        "proposal",
        "evidence",
        "decision",
        "execution"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "trace_id": {
      "type": "string"
    },
    "record_type": {
      "type": "string"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "writer_key_id": {
      "type": "string"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]+$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
