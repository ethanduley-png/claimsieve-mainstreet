{
  "schema_version": "claimsieve.authority_compression_conformance.v1",
  "formal_source": "rocq/AuthorityCompression.v",
  "necessity_source": "rocq/AuthorityCompressionNecessity.v",
  "authenticity_source": "rocq/AuthorityCompressionAuthenticity.v",
  "production_source": "rust/crates/runtime/src/lib.rs",
  "permit_schema": "schemas/permit.schema.json",
  "target": "execution authority factors through an authenticated compact permit without traversing the full evidence archive",
  "guards": [
    {
      "name": "authenticity",
      "formal_tokens": ["authenticated", "verify_authenticated"],
      "production_tokens": ["authority_keys", "verify_signature(authority, \"permit-v1\""],
      "status": "implemented"
    },
    {
      "name": "historical_authority",
      "formal_tokens": ["cert_authorized", "execution_implies_original_decision_allow"],
      "production_tokens": ["decision.verdict != Verdict::Allow", "decision does not match independent kernel reevaluation", "sign(&self.signing_key, \"permit-v1\""],
      "status": "implemented_at_permit_issuance_and_rechecked_at_execution"
    },
    {
      "name": "revocation",
      "formal_tokens": ["cert_revoked", "revocation_dominates_compact_certificate"],
      "production_tokens": ["self.containment.is_revoked(&permit.permit_id)", "permit revoked"],
      "status": "implemented"
    },
    {
      "name": "consumption",
      "formal_tokens": ["cert_consumed", "consumed_compact_certificate_cannot_execute"],
      "production_tokens": ["permit.max_uses != 1", ".reserve(&permit.permit_id, &permit.action_digest, sequence)?", "RuntimeError::Replay"],
      "status": "implemented_by_one_use_permit_and_atomic_reservation"
    },
    {
      "name": "action_binding",
      "formal_tokens": ["cert_action_digest", "action_binding_of_compact_verifier"],
      "production_tokens": ["permit.action_digest.clone()", "action_digest(proposal)?", "permit binding mismatch: {name}"],
      "status": "implemented"
    },
    {
      "name": "policy_binding",
      "formal_tokens": ["cert_policy_digest", "policy_binding_of_compact_verifier"],
      "production_tokens": ["permit.policy_digest.clone()", "digest(policy)?", "permit.signed_policy_digest != signed_policy_digest"],
      "status": "implemented_but_currently_requires_full_policy_input"
    },
    {
      "name": "identity_binding",
      "formal_tokens": ["cert_identity_digest", "identity_binding_of_compact_verifier"],
      "production_tokens": ["permit.tenant_id.clone()", "permit.campaign_id.clone()", "permit.principal.clone()"],
      "status": "implemented_as_explicit_tuple_not_single_digest"
    },
    {
      "name": "not_before",
      "formal_tokens": ["cert_valid_from", "not_yet_valid_compact_certificate_invalid"],
      "production_tokens": ["sequence < permit.valid_from_seq", "permit outside validity sequence"],
      "status": "implemented"
    },
    {
      "name": "expiry",
      "formal_tokens": ["cert_expires_at", "expired_compact_certificate_invalid"],
      "production_tokens": ["sequence > permit.expires_at_seq", "permit outside validity sequence"],
      "status": "implemented"
    }
  ],
  "audit_links": [
    {
      "name": "evidence_root",
      "formal_tokens": ["cert_evidence_digest", "evidence_digest_is_not_runtime_guard"],
      "production_tokens": ["permit.evidence_root.clone()", "decision.evidence_root != evidence_root(evidence)?"],
      "target_role": "signed reconstruction pointer, not full evidence traversal"
    },
    {
      "name": "decision_digest",
      "formal_tokens": ["execution_implies_reconstructible_authority"],
      "production_tokens": ["permit.decision_digest != digest(decision)?"],
      "target_role": "signed pointer to exact authorizing decision"
    }
  ],
  "known_gaps": [
    {
      "id": "FULL_EVIDENCE_ON_EXECUTION_PATH",
      "severity": "architectural",
      "status": "open",
      "production_tokens": ["evidence: &[Evidence]", "evaluate(proposal, policy, evidence, state, sequence)", "decision.evidence_root != evidence_root(evidence)?"],
      "target": "executor receives compact authority state and current revocation/freshness state, while full evidence remains outside the latency-critical path"
    },
    {
      "id": "FULL_POLICY_AND_DECISION_ON_EXECUTION_PATH",
      "severity": "architectural",
      "status": "open",
      "production_tokens": ["policy: &Policy", "decision: &Decision", "signed_policy_digest: &str"],
      "target": "executor receives only compact current policy identity/status commitments required to determine present executability"
    }
  ]
}
