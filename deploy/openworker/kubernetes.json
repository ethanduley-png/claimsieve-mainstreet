{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "mainstreet-openworker", "namespace": "mainstreet-runtime"},
      "spec": {
        "replicas": 1,
        "selector": {"matchLabels": {"app": "mainstreet-openworker"}},
        "template": {
          "metadata": {"labels": {"app": "mainstreet-openworker"}},
          "spec": {
            "automountServiceAccountToken": false,
            "hostNetwork": false,
            "hostPID": false,
            "hostIPC": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {"type": "RuntimeDefault"}
            },
            "containers": [
              {
                "name": "openworker",
                "image": "ghcr.io/ethanduley-png/claimsieve-openworker@sha256:REPLACE_WITH_RELEASE_IMAGE_DIGEST",
                "imagePullPolicy": "IfNotPresent",
                "command": ["python", "-m", "mainstreet_runtimes.openworker_production_server"],
                "args": ["--host", "0.0.0.0", "--port", "8080"],
                "ports": [{"containerPort": 8080, "protocol": "TCP"}],
                "env": [
                  {"name": "PYTHONPATH", "value": "/opt/mainstreet/python"},
                  {"name": "COWORKER_STATE_DIR", "value": "/var/lib/mainstreet/openworker"},
                  {"name": "MAINSTREET_CLAIMSIEVE_ENDPOINT", "value": "https://claimsieve-intake.mainstreet-system.svc.cluster.local:8443/v1/runtime/openworker/intents"},
                  {"name": "MAINSTREET_MODEL_GATEWAY_ENDPOINT", "value": "https://model-gateway.mainstreet-system.svc.cluster.local:8443/v1/runtime/openworker/completions"},
                  {"name": "MAINSTREET_MTLS_CA_FILE", "value": "/var/run/mainstreet/mtls/ca.crt"},
                  {"name": "MAINSTREET_MTLS_CERT_FILE", "value": "/var/run/mainstreet/mtls/tls.crt"},
                  {"name": "MAINSTREET_MTLS_KEY_FILE", "value": "/var/run/mainstreet/mtls/tls.key"},
                  {"name": "OPENWORKER_RUNTIME_COMMIT", "value": "86c57f0692a5a318e55d1b9e0188d798b9fc5690"}
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "capabilities": {"drop": ["ALL"]},
                  "seccompProfile": {"type": "RuntimeDefault"}
                },
                "volumeMounts": [
                  {"name": "runtime-tmp", "mountPath": "/tmp"},
                  {"name": "runtime-state", "mountPath": "/var/lib/mainstreet/openworker"},
                  {"name": "claimsieve-mtls", "mountPath": "/var/run/mainstreet/mtls", "readOnly": true}
                ],
                "startupProbe": {
                  "httpGet": {"path": "/v1/health", "port": 8080, "scheme": "HTTP"},
                  "periodSeconds": 2,
                  "failureThreshold": 30,
                  "timeoutSeconds": 1
                },
                "readinessProbe": {
                  "httpGet": {"path": "/v1/health", "port": 8080, "scheme": "HTTP"},
                  "periodSeconds": 5,
                  "failureThreshold": 3,
                  "timeoutSeconds": 1
                },
                "livenessProbe": {
                  "httpGet": {"path": "/v1/health", "port": 8080, "scheme": "HTTP"},
                  "periodSeconds": 10,
                  "failureThreshold": 3,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "requests": {"cpu": "100m", "memory": "256Mi"},
                  "limits": {"cpu": "2", "memory": "2Gi"}
                }
              }
            ],
            "volumes": [
              {"name": "runtime-tmp", "emptyDir": {"sizeLimit": "256Mi"}},
              {"name": "runtime-state", "persistentVolumeClaim": {"claimName": "openworker-runtime-state"}},
              {
                "name": "claimsieve-mtls",
                "secret": {
                  "secretName": "openworker-claimsieve-mtls",
                  "defaultMode": 288,
                  "items": [
                    {"key": "ca.crt", "path": "ca.crt"},
                    {"key": "tls.crt", "path": "tls.crt"},
                    {"key": "tls.key", "path": "tls.key"},
                    {"key": "openworker.token", "path": "openworker.token"}
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {"name": "openworker-default-deny", "namespace": "mainstreet-runtime"},
      "spec": {
        "podSelector": {"matchLabels": {"app": "mainstreet-openworker"}},
        "policyTypes": ["Ingress", "Egress"]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {"name": "openworker-allow-governed-egress", "namespace": "mainstreet-runtime"},
      "spec": {
        "podSelector": {"matchLabels": {"app": "mainstreet-openworker"}},
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "mainstreet-system"}}, "podSelector": {"matchLabels": {"app": "claimsieve-intake"}}}],
            "ports": [{"protocol": "TCP", "port": 8443}]
          },
          {
            "to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "mainstreet-system"}}, "podSelector": {"matchLabels": {"app": "model-gateway"}}}],
            "ports": [{"protocol": "TCP", "port": 8443}]
          },
          {
            "to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}}, "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}}],
            "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]
          }
        ]
      }
    }
  ]
}
