{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "claimsieve-openhands-adversary",
    "namespace": "claimsieve-openhands",
    "labels": {
      "app.kubernetes.io/name": "claimsieve-openhands-adversary",
      "app.kubernetes.io/component": "untrusted-proposer"
    }
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "claimsieve-openhands-adversary"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "claimsieve-openhands-adversary",
          "app.kubernetes.io/component": "untrusted-proposer"
        }
      },
      "spec": {
        "runtimeClassName": "gvisor",
        "serviceAccountName": "claimsieve-openhands-proposer",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "hostNetwork": false,
        "hostPID": false,
        "hostIPC": false,
        "terminationGracePeriodSeconds": 10,
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "openhands",
            "image": "REPLACE_WITH_PINNED_OPENHANDS_IMAGE_DIGEST",
            "imagePullPolicy": "IfNotPresent",
            "workingDir": "/workspace",
            "securityContext": {
              "privileged": false,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "env": [
              {
                "name": "CLAIMSIEVE_REFERENCE_MODE",
                "value": "offline-adversarial-proposal-only"
              }
            ],
            "volumeMounts": [
              {
                "name": "workspace",
                "mountPath": "/workspace"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2Gi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "workspace",
            "emptyDir": {
              "sizeLimit": "2Gi"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "128Mi"
            }
          }
        ]
      }
    }
  }
}
