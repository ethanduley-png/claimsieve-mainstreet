{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimsieve.example/schemas/policy.schema.json",
  "title": "ClaimSieve Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "tenant_id",
    "allowed_principals",
    "allowed_action_kinds",
    "allowed_effect_classes",
    "allowed_trust_domains",
    "allowed_subgoals",
    "approval_required_for",
    "allowed_approver_key_ids",
    "allowed_approver_identities",
    "required_evidence",
    "trusted_evidence_sources",
    "trusted_evidence_key_ids",
    "freshness_window",
    "campaign_limits",
    "deny_risk_tags",
    "suspend_risk_tags"
  ],
  "properties": {
    "schema_version": {
      "const": "claimsieve.policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "allowed_action_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_effect_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_trust_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_subgoals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "approval_required_for": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "freshness_window": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "campaign_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_denials",
        "max_new_destinations",
        "max_sessions",
        "max_boundary_crossings",
        "max_encoded_fragments"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_denials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_new_destinations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_boundary_crossings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_encoded_fragments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "deny_risk_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "suspend_risk_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_approver_key_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "allowed_principals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "allowed_approver_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "trusted_evidence_sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "trusted_evidence_key_ids": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
