{
  "id": "mainstreet-agent-reach-observer",
  "name": "MainStreet Permit-Gated Agent Reach Observer",
  "version": "0.34.0",
  "description": "Prepares read-only capability requests and exact ClaimSieve bindings, then validates permit-bound tainted observations. It has no execution authority of its own.",
  "entry": "../src/agent-reach-untrusted.js",
  "trust": "explicitly-untrusted",
  "capabilities": [
    "observation.request.prepare",
    "observation.claimsieve_binding.prepare",
    "observation.envelope.validate"
  ],
  "requiredEnvironment": [
    "AGENT_REACH_OBSERVER_SPIFFE_ID"
  ],
  "forbiddenEnvironmentPrefixes": [
    "CLAIMSIEVE_SIGNING_",
    "TWILIO_",
    "STRIPE_",
    "AWS_SECRET_",
    "OPENAI_API_KEY",
    "GITHUB_WRITER_"
  ],
  "forbiddenCapabilities": [
    "network.prepermit",
    "provider.write",
    "provider.execute",
    "permit.sign",
    "approval.create",
    "shell.generic"
  ]
}
